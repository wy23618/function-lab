{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "function-lab",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "routes": [
    { "pattern": "func.hellovian.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
